# SUPABASE_URL: Base URL for your Supabase project (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Public anonymous key from your Supabase Project Settings > API
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# MAPS_API_KEY: Google Maps Platform API key for map overlays and static/tile map rendering
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
